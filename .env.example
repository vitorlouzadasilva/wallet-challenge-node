APP_PORT=3010
# Interface da máquina que publica a aplicação. O padrão mantém acesso somente local.
APP_BIND_ADDRESS=127.0.0.1
# URL usada no navegador; ajuste também ao mudar APP_PORT. Sem caminho ou barra de subdiretório.
APP_ORIGIN=http://localhost:3010
TRUSTED_PROXY_IP_HEADER=
FORWARD_DB_PORT=3311
MYSQL_DATABASE=wallet_node_challenge
MYSQL_USER=wallet_node_dev
# Defina senhas distintas, locais e seguras no .env. Use caracteres seguros para URL.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
